{
  "name": "portfolio-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first trading journal: positions, partial exits, live prices and monthly P&L.",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build-standalone.mjs",
    "build:site": "node scripts/check-functions.mjs && node scripts/build-standalone.mjs && node scripts/assemble-site.mjs",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "test": "node --test tests/*.test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "check:live": "node scripts/live-check.mjs",
    "check:functions": "node scripts/check-functions.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "trading",
    "journal",
    "portfolio",
    "pnl",
    "vanilla-js"
  ],
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
